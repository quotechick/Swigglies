# Swigglies settings. Nothing reads this file by itself: export these in your shell, or use it as a systemd
# EnvironmentFile (for example /etc/swigglies.env, owned by root, mode 600).

SWIGGLIES_KEY=                  # required: 64 hex chars (openssl rand -hex 32). Seals the wallet seeds. Back it up.
CLUSTER=devnet                # devnet (recommended) | sim (no network) | mainnet-beta (real money, at your own risk)

# RPC_URL=                    # optional: your own RPC endpoint
# PUBLIC_URL=https://your-host.example/swigglies/   # used for links in /api/standings
# STATE_DIR=./.state          # wallets (sealed), seat keys, state, event log
# PORT=8162
# HOST=127.0.0.1
# TICK_MS=12000               # autopilot turn interval
# EPOCH_MS=120000             # upkeep + rent roll interval
# SEAT_HOLD_MS=1200000        # a seat returns to the autopilot after this long without a call
# UNIT_LAMPORTS=10000000      # hood unit before the office stakes the five (it is rescaled at staking)
# STAKE_SOL=1                 # each dot's opening stake; the office stakes once it holds ~5x this. 0 = 80% of the office, split
# MAX_TX_PER_DAY=3000         # on-chain moves per player wallet per UTC day (bounds fee burn if a key leaks)
# AUTO_AIRDROP=0              # turn off the devnet faucet retry
